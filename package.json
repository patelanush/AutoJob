{
  "name": "job-apply-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local safety-first job application preparation; final submission is human-only",
  "scripts": {
    "setup": "node scripts/run.mjs cli setup",
    "apply": "node scripts/run.mjs cli apply",
    "dry-run": "node scripts/run.mjs cli dry-run",
    "dashboard": "node scripts/run.mjs cli dashboard",
    "status": "node scripts/run.mjs cli status",
    "retry": "node scripts/run.mjs cli retry",
    "history": "node scripts/run.mjs cli history",
    "credentials": "node scripts/run.mjs cli credentials",
    "gmail": "node scripts/run.mjs cli gmail",
    "test": "node scripts/run.mjs vitest run",
    "test:integration": "node scripts/run.mjs playwright test",
    "typecheck": "node scripts/run.mjs tsc --noEmit",
    "lint": "node scripts/run.mjs eslint .",
    "format": "node scripts/run.mjs prettier --write .",
    "format:check": "node scripts/run.mjs prettier --check .",
    "build": "node scripts/run.mjs vite build",
    "dev": "node scripts/run.mjs vite --host 127.0.0.1",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "googleapis": "^160.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.9.0",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "node": "^24.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
